# ==============================================================================
# HOTEL BOOKING APPLICATION - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Sao chep file nay thanh '.env' va dieu chinh cac thong so phu hop voi moi truong.
# KHONG duoc commit file '.env' chua mat khau thuc te len kho luu tru Git.

# --- Database (PostgreSQL) Configuration ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hotel_booking_db
DB_USERNAME=hotel_user
DB_PASSWORD=hotel_secure_password_2025
DB_URL=jdbc:postgresql://localhost:5432/hotel_booking_db

# --- Docker Compose Specific ---
POSTGRES_DB=hotel_booking_db
POSTGRES_USER=hotel_user
POSTGRES_PASSWORD=hotel_secure_password_2025

# --- Spring Boot Backend Configuration ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
JPA_HIBERNATE_DDL_AUTO=update
JPA_SHOW_SQL=true

# --- Frontend Configuration ---
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/api
